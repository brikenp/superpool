# Kopjojeni në .env.local dhe plotësoni me të dhënat e projektit Firebase
# (Firebase Console → Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=superpool-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=superpool-app
VITE_FIREBASE_STORAGE_BUCKET=superpool-app.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=europe-west1
# true = përdor emulatorët lokalë (firebase emulators:start)
VITE_USE_EMULATORS=false
