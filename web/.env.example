# Opsionale: vlerat e projektit "superpool-system" janë të vendosura si parazgjedhje te src/lib/firebase.js.
# Plotësoni vetëm nëse doni të përdorni një projekt tjetër Firebase (p.sh. për testim).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FUNCTIONS_REGION=europe-west1
# true = përdor emulatorët lokalë (firebase emulators:start --project demo-superpool)
VITE_USE_EMULATORS=false
