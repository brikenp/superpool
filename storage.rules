rules_version = '2';

// Dokumentet e projekteve dhe të klientëve. Leja kontrollohet nga roli në Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function userDoc() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
    function role() { return userDoc().data.role; }
    function active() { return request.auth != null && userDoc().data.active == true; }
    function isRole(roles) { return active() && role() in roles; }
    function inTeam(projectId) {
      return request.auth.uid in firestore.get(/databases/(default)/documents/projects/$(projectId)).data.teamUids;
    }
    function smallFile() { return request.resource.size < 25 * 1024 * 1024; }

    match /projects/{projectId}/{fileName} {
      allow read: if isRole(['admin', 'magazine', 'oferta', 'projekte']) || (active() && inTeam(projectId));
      allow create: if smallFile() && (isRole(['admin', 'projekte']) || (active() && inTeam(projectId)));
      allow delete: if isRole(['admin', 'projekte']);
    }

    match /clients/{clientId}/{fileName} {
      allow read: if isRole(['admin', 'magazine', 'oferta', 'projekte', 'kimikate']);
      allow create: if smallFile() && isRole(['admin', 'oferta', 'projekte', 'kimikate']);
      allow delete: if isRole(['admin', 'oferta', 'kimikate']);
    }

    // Fotot e artikujve: i shohin të gjithë përdoruesit aktivë, i ndryshon magazina.
    match /products/{productId}/{fileName} {
      allow read: if active();
      allow create, update: if isRole(['admin', 'magazine']) && smallFile()
        && request.resource.contentType.matches('image/.*');
      allow delete: if isRole(['admin', 'magazine']);
    }

    match /settings/{fileName} {
      allow read: if active();
      allow write: if isRole(['admin']) && smallFile();
    }
  }
}
